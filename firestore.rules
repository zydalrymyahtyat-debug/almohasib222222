rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. دالة التحقق من حساب الأدمن الخاص بك
    function isAdmin() {
      return request.auth != null && request.auth.uid == '1Ip4Pac4WcWRbd38x3Za1065osx2';
    }

    // 2. حماية بيانات الدخول الخاصة بالمشتركين
    match /users/{userId} {
      allow read, write: if (request.auth != null && request.auth.uid == userId) || isAdmin();
    }

    // 3. حماية مجلد العملاء والموردين (persons)
    match /persons/{docId} {
      allow read, update, delete: if (request.auth != null && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if (request.auth != null && request.resource.data.userId == request.auth.uid) || isAdmin();
    }

    // 4. حماية مجلد العمليات المالية (transactions)
    match /transactions/{docId} {
      allow read, update, delete: if (request.auth != null && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if (request.auth != null && request.resource.data.userId == request.auth.uid) || isAdmin();
    }

    // 5. حماية مجلد المصروفات (expenses)
    match /expenses/{docId} {
      allow read, update, delete: if (request.auth != null && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if (request.auth != null && request.resource.data.userId == request.auth.uid) || isAdmin();
    }

    // 6. الأقسام الجديدة: المخزون، حركة المخزون
    match /inventory_items/{docId} {
      allow read, update, delete: if (request.auth != null && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if (request.auth != null && request.resource.data.userId == request.auth.uid) || isAdmin();
    }
    match /inventory_movements/{docId} {
      allow read, update, delete: if (request.auth != null && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if (request.auth != null && request.resource.data.userId == request.auth.uid) || isAdmin();
    }

    // 7. الفواتير الجديدة والعمليات النقدية
    match /pos_invoices/{docId} {
      allow read, update, delete: if (request.auth != null && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if (request.auth != null && request.resource.data.userId == request.auth.uid) || isAdmin();
    }
    match /cash_transactions/{docId} {
      allow read, update, delete: if (request.auth != null && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if (request.auth != null && request.resource.data.userId == request.auth.uid) || isAdmin();
    }

    // 8. قسم الآبار الارتوازية وإعداداتها
    match /wells/{docId} {
      allow read, update, delete: if (request.auth != null && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if (request.auth != null && request.resource.data.userId == request.auth.uid) || isAdmin();
    }
    match /well_settings/{docId} {
      allow read, update, delete: if (request.auth != null && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if (request.auth != null && request.resource.data.userId == request.auth.uid) || isAdmin();
    }

    // 9. طلبات تصريح الأجهزة (ميزة ربط الأجهزة)
    match /deviceRequests/{docId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if (request.auth != null && resource.data.userId == request.auth.uid) || isAdmin();
      allow update, delete: if isAdmin();
    }

    // 10. السماح بظهور التحديثات والإشعارات للجميع وتعديلها للأدمن فقط
    match /system/update {
       allow read: if true;
       allow write: if isAdmin();
    }
    match /system/announcement {
       allow read: if true;
       allow write: if isAdmin();
    }
    match /system/{document=**} {
       allow read: if request.auth != null;
       allow write: if isAdmin();
    }

    // 11. قوالب الرسائل (جديد)
    match /message_templates/{docId} {
      allow read, update, delete: if (request.auth != null && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if (request.auth != null && request.resource.data.userId == request.auth.uid) || isAdmin();
    }

    // 12. إغلاق أي مسارات أخرى لم يتم ذكرها للحماية المطلقة (الأدمن فقط)
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
